{
  "expo": {
    "name": "Dakakeen",
    "slug": "brandak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/dakakeen-logo.png",
    "scheme": "dakakeen",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FEFCF7",
    "ios": {
      "bundleIdentifier": "app.dakakeen",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "دكاكين محتاج يوصل لصورك عشان ترفع صور المنتجات ولوجو المتجر وإيصال التحويل.",
        "NSCameraUsageDescription": "دكاكين محتاج الكاميرا عشان تصوّر المنتجات أو إيصال التحويل.",
        "CFBundleDevelopmentRegion": "ar",
        "ExpoLocalization_forcesRTL": true,
        "CFBundleLocalizations": [
          "ar"
        ]
      }
    },
    "android": {
      "package": "app.dakakeen",
      "adaptiveIcon": {
        "backgroundColor": "#FEFCF7",
        "foregroundImage": "./assets/brand/dakakeen-mark.png",
        "monochromeImage": "./assets/brand/dakakeen-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/dakakeen-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEFCF7",
          "image": "./assets/brand/dakakeen-mark.png",
          "imageWidth": 150,
          "dark": {
            "backgroundColor": "#17110D",
            "image": "./assets/brand/dakakeen-mark.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "ar"
          ],
          "forcesRTL": true
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "دكاكين محتاج يوصل لصورك عشان ترفع صور المنتجات ولوجو المتجر وإيصال التحويل.",
          "cameraPermission": "دكاكين محتاج الكاميرا عشان تصوّر المنتجات أو إيصال التحويل."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/reem-kufi/500Medium/ReemKufi_500Medium.ttf",
            "node_modules/@expo-google-fonts/reem-kufi/700Bold/ReemKufi_700Bold.ttf",
            "node_modules/@expo-google-fonts/ibm-plex-sans-arabic/400Regular/IBMPlexSansArabic_400Regular.ttf",
            "node_modules/@expo-google-fonts/ibm-plex-sans-arabic/500Medium/IBMPlexSansArabic_500Medium.ttf",
            "node_modules/@expo-google-fonts/ibm-plex-sans-arabic/600SemiBold/IBMPlexSansArabic_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/ibm-plex-sans-arabic/700Bold/IBMPlexSansArabic_700Bold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "forcesRTL": true,
      "eas": {
        "projectId": "20853a30-b30d-4049-b829-a108e3f5a788"
      }
    },
    "owner": "mmubarakdev"
  }
}
