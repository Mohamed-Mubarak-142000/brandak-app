{
  "expo": {
    "name": "Fatrina",
    "slug": "brandak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/fatrina-icon.png",
    "scheme": "fatrina",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FEFCF7",
    "ios": {
      "bundleIdentifier": "app.dakakeen",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "فاترينة محتاج يوصل لصورك عشان ترفع صور المنتجات ولوجو المتجر وإيصال التحويل.",
        "NSCameraUsageDescription": "فاترينة محتاج الكاميرا عشان تصوّر المنتجات أو إيصال التحويل.",
        "CFBundleDevelopmentRegion": "ar",
        "ExpoLocalization_forcesRTL": true,
        "CFBundleLocalizations": [
          "ar"
        ]
      }
    },
    "android": {
      "package": "app.dakakeen",
      "adaptiveIcon": {
        "backgroundColor": "#F16B21",
        "foregroundImage": "./assets/brand/fatrina-adaptive.png",
        "monochromeImage": "./assets/brand/fatrina-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/fatrina-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEFCF7",
          "image": "./assets/brand/fatrina-mark.png",
          "imageWidth": 150,
          "dark": {
            "backgroundColor": "#17110D",
            "image": "./assets/brand/fatrina-mark.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "ar"
          ],
          "forcesRTL": true
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "فاترينة محتاج يوصل لصورك عشان ترفع صور المنتجات ولوجو المتجر وإيصال التحويل.",
          "cameraPermission": "فاترينة محتاج الكاميرا عشان تصوّر المنتجات أو إيصال التحويل.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "forcesRTL": true,
      "eas": {
        "projectId": "20853a30-b30d-4049-b829-a108e3f5a788"
      }
    },
    "owner": "mmubarakdev"
  }
}
